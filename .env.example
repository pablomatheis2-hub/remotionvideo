# Required — powers LLM chat (config generation, conversational editing, image analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables voiceover generation via ElevenLabs during rendering
# If not set, videos render without voiceover audio
ELEVENLABS_API_KEY=...

# Optional — ElevenLabs voice ID (defaults to "21m00Tcm4TlvDq8ikWAM" / Rachel)
# ELEVENLABS_VOICE_ID=...

# Render server — set on Vercel to point the frontend at your local render server
# Example: https://xxxx.ngrok-free.app (the ngrok URL exposing your local render server)
# NEXT_PUBLIC_RENDER_API_URL=

# Render server (local only) — port for the standalone render server (defaults to 3001)
# PORT=3001

# Render server (local only) — allowed CORS origin (defaults to * for development)
# CORS_ORIGIN=https://your-app.vercel.app
